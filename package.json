{
  "name": "vibe-coding-governance",
  "version": "1.1.0",
  "description": "Universal Vibe Coding Code & UI Design Governance Framework: Deterministic Clean Architecture, Strict Anti-Slop Discipline, and Autonomous Quality Gate Enforcement",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "format": "biome format --write src tests scripts",
    "format:check": "biome format src tests scripts",
    "lint": "biome lint src tests scripts",
    "lint:fix": "biome lint --write src tests scripts",
    "typecheck": "tsc --noEmit",
    "arch:check": "node scripts/arch-check.mjs",
    "ui:tokens": "node scripts/design-token-check.mjs",
    "ui:lint": "node scripts/ui-review.mjs",
    "ui:screenshot": "node scripts/screenshot.mjs",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/integration/*.test.ts tests/governance/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.ts",
    "test:governance": "node --test tests/governance/*.test.mjs",
    "security:check": "node scripts/security-check.mjs",
    "rule:sync": "node scripts/rule-sync.mjs",
    "generate:diagrams": "node scripts/generate-diagrams.mjs && node scripts/generate-zh.mjs && node scripts/generate-design-diagrams.mjs",
    "quality": "node scripts/verify-fix-loop.mjs"
  },
  "keywords": [
    "vibe-coding",
    "ai-agent",
    "code-quality",
    "ui-governance",
    "anti-slop",
    "design-tokens",
    "clean-architecture",
    "codex",
    "claude-code",
    "cursor"
  ],
  "author": "Pingus <pinzhuo0905@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}